<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules (devices below API 31).
   The DataStore file holds per-account cached data (profile, favorites);
   it must not outlive the device/account it was written on.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude
        domain="file"
        path="datastore/settings.json" />
</full-backup-content>
